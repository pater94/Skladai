{
  "name": "skladai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "npx cap sync && node scripts/fix-spm-paths.mjs",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "build:android": "npx cap sync android",
    "build:ios": "npx cap sync ios && node scripts/fix-spm-paths.mjs",
    "postinstall": "node scripts/fix-spm-paths.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "qa": "playwright test",
    "qa:update-snapshots": "playwright test --update-snapshots",
    "audit:run": "tsx test/auditor/run-audit.ts",
    "audit:review": "tsx test/auditor/review-results.ts"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-health": "^8.4.2",
    "@revenuecat/purchases-capacitor": "^12.3.2",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "browser-image-compression": "^2.0.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "canvas": "^3.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.2",
    "typescript": "^5"
  }
}
